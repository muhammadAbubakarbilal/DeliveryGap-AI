# Copy to .env. Set unique local credentials before starting Compose.
POSTGRES_USER=deliverygap
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=deliverygap
DATABASE_URL=postgresql+psycopg://deliverygap:replace-with-a-local-database-password@localhost:5432/deliverygap
# Neon CLI writes actual credentials to ignored .env.local. See docs/neon-setup.md.
# Use the direct connection for migrations; keep the pooled URL for API traffic.
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AI_GATEWAY_BASE_URL=
NEON_AI_GATEWAY_TOKEN=
NEON_EMBEDDING_MODEL=qwen3-embedding-0-6b
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SESSION_HOURS=8
INTERNAL_API_URL=http://localhost:8000
MINIO_ROOT_USER=deliverygap-local
MINIO_ROOT_PASSWORD=replace-with-a-local-storage-password
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=deliverygap-local
S3_SECRET_KEY=replace-with-a-local-storage-password
S3_BUCKET=deliverygap-private
# Used only by the explicit seed command; no built-in admin password.
SEED_ADMIN_EMAIL=admin@deliverygap.example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Workspace Admin
